    {"word": "ἐλύθην", "transliteration": "elythēn", "lemma": "λύω", "form": "aor pass 1sg", "definition": "I was loosed"},
    {"word": "ἔλαβον", "transliteration": "elabon", "lemma": "λαμβάνω", "form": "2nd aor act 1sg", "definition": "I took"},
    {"word": "ἔβαλον", "transliteration": "ebalon", "lemma": "βάλλω", "form": "2nd aor act 1sg", "definition": "I threw"},
