  "grammar": {
    "topic": "Present Active Indicative",
    "explanation": "The present active indicative expresses ongoing action. Greek verbs have stem plus personal endings. The paradigm verb λύω shows the pattern.",
    "paradigms": [
      {
        "name": "λύω conjugation",
        "headers": [
          "Person",
          "Singular",
          "Plural"
        ],
        "rows": [
          [
            "1st",
            "λύω (I loose)",
            "λύομεν (we loose)"
          ],
          [
            "2nd",
            "λύεις (you loose)",
            "λύετε (you all loose)"
          ],
          [
            "3rd",
            "λύει (he/she looses)",
            "λύουσι(ν) (they loose)"
          ]
        ]
      },
      {
        "name": "Personal Endings",
        "headers": [
          "Person",
          "Sg",
          "Pl"
        ],
        "rows": [
          [
            "1st",
            "-ω",
            "-ομεν"
          ],
          [
            "2nd",
            "-εις",
            "-ετε"
          ],
          [
            "3rd",
            "-ει",
            "-ουσι(ν)"
          ]
        ]
      }
    ],
    "rules": [
      "Present expresses ongoing/repeated action",
      "Endings show person and number",
      "Subject pronouns usually omitted",
      "3rd pl adds movable ν before vowels"
    ]
  },
