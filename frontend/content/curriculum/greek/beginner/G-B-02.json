  "grammar": {
    "topic": "Breathings, Accents, and Diphthongs",
    "explanation": "Every Greek word beginning with a vowel carries a breathing mark. Rough breathing adds an h-sound, smooth breathing indicates no h-sound. Greek uses three accent marks.",
    "paradigms": [
      {
        "name": "Breathing Marks",
        "headers": [
