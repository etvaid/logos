  "grammar": {
    "topic": "Third Declension - Consonant and I-Stems",
    "explanation": "The third declension is the largest and most varied. Consonant stems and i-stems differ primarily in genitive plural (-um vs -ium) and neuter nominative/accusative plural (-a vs -ia).",
    "paradigms": [
      {
        "name": "Consonant Stem: rex, regis (m)",
        "headers": ["Case", "Singular", "Plural"],
        "rows": [
          ["Nominative", "rex", "reges"],
          ["Genitive", "regis", "regum"],
          ["Dative", "regi", "regibus"],
          ["Accusative", "regem", "reges"],
          ["Ablative", "rege", "regibus"]
        ]
      },
      {
        "name": "I-Stem: civis, civis (c)",
        "headers": ["Case", "Singular", "Plural"],
        "rows": [
          ["Nominative", "civis", "cives"],
          ["Genitive", "civis", "civium"],
          ["Dative", "civi", "civibus"],
          ["Accusative", "civem", "cives"],
          ["Ablative", "cive", "civibus"]
        ]
      }
    ],
    "rules": [
      "Consonant stems: genitive plural -um",
      "I-stems: genitive plural -ium",
      "Neuter i-stems: nom/acc plural -ia",
      "I-stems: parisyllabics or stems in two consonants"
    ]
  },
