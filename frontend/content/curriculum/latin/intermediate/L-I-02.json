  "grammar": {
    "topic": "Perfect and Imperfect Tenses",
    "explanation": "Latin distinguishes aspect in the past: the imperfect describes ongoing, habitual, or repeated actions, while the perfect describes completed, single actions. The imperfect uses -ba- as a tense marker; the perfect uses a special stem.",
    "paradigms": [
      {
        "name": "Perfect Active Indicative (amo)",
        "headers": ["Person", "Singular", "Plural"],
        "rows": [
          ["1st", "amavi (I loved/have loved)", "amavimus"],
          ["2nd", "amavisti", "amavistis"],
          ["3rd", "amavit", "amaverunt"]
        ]
      },
      {
        "name": "Imperfect Active Indicative (amo)",
        "headers": ["Person", "Singular", "Plural"],
        "rows": [
          ["1st", "amabam (I was loving)", "amabamus"],
          ["2nd", "amabas", "amabatis"],
          ["3rd", "amabat", "amabant"]
        ]
      },
      {
        "name": "Perfect Stem Types",
        "headers": ["Type", "Example", "Perfect Stem"],
        "rows": [
          ["v-perfect", "amavi", "amav-"],
          ["u-perfect", "habui", "habu-"],
          ["s-perfect", "scripsi", "scrips-"],
          ["Reduplication", "cecidi (cado)", "cecid-"],
          ["Lengthening", "vidi (video)", "vid-"]
        ]
      }
    ],
    "rules": [
      "Imperfect: stem + ba + personal endings",
      "Perfect: perfect stem + special endings (-i, -isti, -it, -imus, -istis, -erunt)",
      "Imperfect = was doing, used to do, kept doing",
      "Perfect = did, has done, completed action"
    ]
  },
  "exercises": [
    {
      "type": "translation",
      "question": "Translate: Caesar venit, vidit, vicit.",
      "answer": "Caesar came, saw, conquered.",
      "hints": ["Three perfects showing completed actions"]
    },
    {
      "type": "tense_identification",
      "question": "What is the difference: 'scribebat' vs 'scripsit'?",
      "answer": "scribebat = was writing (imperfect/ongoing); scripsit = wrote (perfect/completed)"
    }
  ],
