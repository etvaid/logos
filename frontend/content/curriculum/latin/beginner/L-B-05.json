  "grammar": {
    "topic": "Second Conjugation - Present Indicative Active",
    "explanation": "Second conjugation verbs have -ere as their infinitive ending with a LONG e. This distinguishes them from third conjugation verbs which also have -ere but with a SHORT e. The theme vowel is 'e' which appears throughout the conjugation.",
    "paradigms": [
      {
        "name": "moneo - Present Indicative Active",
        "headers": ["Person", "Singular", "Plural"],
        "rows": [
          ["1st", "moneo (I warn)", "monemus (we warn)"],
          ["2nd", "mones (you warn)", "monetis (you all warn)"],
          ["3rd", "monet (he/she/it warns)", "monent (they warn)"]
        ]
      },
      {
        "name": "Comparison: 1st vs 2nd Conjugation",
        "headers": ["Person", "1st Conj (amo)", "2nd Conj (moneo)"],
        "rows": [
          ["1st sg", "amo", "moneo"],
          ["2nd sg", "amas", "mones"],
          ["3rd sg", "amat", "monet"],
          ["1st pl", "amamus", "monemus"],
          ["2nd pl", "amatis", "monetis"],
          ["3rd pl", "amant", "monent"]
        ]
      }
    ],
    "rules": [
      "Second conjugation infinitives end in -ere (long e)",
      "The theme vowel 'e' appears before personal endings",
      "In 1st person singular, -e + -o contracts to -eo",
      "Compare: amat (1st) vs monet (2nd) - the vowel before -t differs"
