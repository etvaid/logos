      {
        "name": "All Four Conjugations Compared",
        "headers": ["Conj", "Infinitive", "1st Sg", "3rd Sg", "3rd Pl"],
        "rows": [
          ["1st", "-are", "amo", "amat", "amant"],
          ["2nd", "-ere (long)", "moneo", "monet", "monent"],
