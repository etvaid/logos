  "grammar": {
    "topic": "First Conjugation - Present Indicative Active",
    "explanation": "First conjugation verbs are identified by the -are ending in the infinitive. To conjugate in the present tense, remove -re from the infinitive and add personal endings. The theme vowel 'a' appears throughout (except in 1st singular where it combines with -o).",
    "paradigms": [
      {
        "name": "amo - Present Indicative Active",
        "headers": ["Person", "Singular", "Plural"],
        "rows": [
          ["1st", "amo (I love)", "amamus (we love)"],
          ["2nd", "amas (you love)", "amatis (you all love)"],
          ["3rd", "amat (he/she/it loves)", "amant (they love)"]
        ]
      },
      {
        "name": "Personal Endings (Active)",
        "headers": ["Person", "Singular", "Plural"],
        "rows": [
          ["1st", "-o", "-mus"],
          ["2nd", "-s", "-tis"],
          ["3rd", "-t", "-nt"]
        ]
      }
    ],
    "rules": [
      "First conjugation infinitives end in -are",
      "The theme vowel 'a' appears before personal endings",
      "In 1st person singular, -a + -o contracts to just -o",
      "Latin does not require subject pronouns; the ending indicates the person"
    ]
  },
