  "grammar": {
    "topic": "Third Declension Nouns",
    "explanation": "The third declension is the largest and most varied. Nouns can be masculine, feminine, or neuter with many different nominative endings. The key is to learn the genitive singular (-is) which reveals the stem for all other cases.",
    "paradigms": [
      {
        "name": "rex, regis (m) - consonant stem",
        "headers": ["Case", "Singular", "Plural"],
        "rows": [
          ["Nominative", "rex", "reges"],
          ["Genitive", "regis", "regum"],
          ["Dative", "regi", "regibus"],
          ["Accusative", "regem", "reges"],
          ["Ablative", "rege", "regibus"]
        ]
      },
      {
        "name": "civis, civis (m/f) - i-stem",
        "headers": ["Case", "Singular", "Plural"],
        "rows": [
          ["Nominative", "civis", "cives"],
          ["Genitive", "civis", "civium"],
          ["Dative", "civi", "civibus"],
          ["Accusative", "civem", "cives"],
          ["Ablative", "cive", "civibus"]
        ]
      },
      {
        "name": "nomen, nominis (n) - neuter",
        "headers": ["Case", "Singular", "Plural"],
        "rows": [
          ["Nominative", "nomen", "nomina"],
          ["Genitive", "nominis", "nominum"],
          ["Dative", "nomini", "nominibus"],
          ["Accusative", "nomen", "nomina"],
          ["Ablative", "nomine", "nominibus"]
        ]
      }
    ],
    "rules": [
      "Always learn the genitive with the nominative (rex, regis)",
      "The stem is found by removing -is from the genitive singular",
      "Neuter nom/acc are identical; neuter plurals end in -a",
      "I-stems have -ium in genitive plural (not -um)"
    ]
  },
