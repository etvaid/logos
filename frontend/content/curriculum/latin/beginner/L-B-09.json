  "grammar": {
    "topic": "Prepositions and Case Usage",
    "explanation": "Latin prepositions govern either the ablative or accusative case. Some prepositions like 'in' and 'sub' take both cases with different meanings: ablative for location/static situations, accusative for motion/direction toward.",
    "paradigms": [
      {
        "name": "Prepositions with Ablative",
        "headers": ["Preposition", "Meaning", "Example"],
        "rows": [
          ["in (+ abl)", "in, on", "in villa (in the house)"],
          ["ex/e", "out of", "ex urbe (out of the city)"],
          ["ab/a", "from, by", "ab amico (from a friend)"],
          ["cum", "with", "cum patre (with father)"],
          ["sine", "without", "sine mora (without delay)"],
          ["de", "down from, about", "de monte (down from the mountain)"],
          ["pro", "for, on behalf of", "pro patria (for the fatherland)"]
        ]
      },
      {
        "name": "Prepositions with Accusative",
        "headers": ["Preposition", "Meaning", "Example"],
        "rows": [
          ["in (+ acc)", "into, onto", "in villam (into the house)"],
          ["ad", "to, toward", "ad urbem (to the city)"],
          ["per", "through", "per silvam (through the forest)"],
          ["trans", "across", "trans flumen (across the river)"],
          ["post", "after, behind", "post cenam (after dinner)"],
          ["propter", "because of", "propter metum (because of fear)"]
        ]
      }
    ],
    "rules": [
      "Ablative = location, static position, means, accompaniment",
      "Accusative = direction, motion toward, extent",
      "in + ablative = where something IS",
      "in + accusative = where something is GOING"
    ]
  },
